NODE_ENV=development
# Simulation is disabled by default and must never be enabled in production.
ALLOW_PAYMENT_SIMULATION=false

PORT=4000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/poafi_db?schema=public"
JWT_SECRET="CHANGE_ME_generate_with_crypto_random_hex_64"
CREDENTIAL_ENCRYPTION_KEY="CHANGE_ME_exactly_32_characters!!"

# =========================================================================
# Mode B: Master Payment Gateway (Centralized Operator Aggregation)
# Money from all operators without their own keys flows into this account
# =========================================================================
AZAMPAY_APP_NAME="POAFI_MASTER"
AZAMPAY_CLIENT_ID="your_azampay_client_id_here"
AZAMPAY_API_KEY="your_azampay_api_key_here"
AZAMPAY_CLIENT_SECRET="your_azampay_client_secret_here"
AZAMPAY_IS_LIVE=false

# Percentage commission the platform owner keeps (e.g. 10 = 10% fee, 90% payout)
PLATFORM_COMMISSION_PERCENT=10

# =========================================================================
# Mode B: Master Payment Gateway (Centralized Operator Aggregation)
# Money from all operators without their own keys flows into this account
# =========================================================================
AZAMPAY_APP_NAME="POAFI_MASTER"
AZAMPAY_CLIENT_ID="your_azampay_client_id_here"
AZAMPAY_API_KEY="your_azampay_api_key_here"
AZAMPAY_CLIENT_SECRET="your_azampay_client_secret_here"
AZAMPAY_IS_LIVE=false

# Percentage commission the platform owner keeps (e.g. 10 = 10% fee, 90% payout)
PLATFORM_COMMISSION_PERCENT=10

