# Copy to .env locally; use your hosting provider's secret manager in production.
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/poafi_db?schema=public"

# Generate unique random values for each environment. Never deploy these example placeholders.
# Example generation commands:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"
# Current encryption implementation expects 32 characters. Generate 32 random bytes and store securely.
CREDENTIAL_ENCRYPTION_KEY="EXAMPLE_ONLY_REPLACE_THIS_32BYTE"

# Per-process PostgreSQL pool limits. Total connections = API instances x pool max + workers.
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Exact browser origins, comma-separated; no trailing slash.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://192.168.56.1:3000"

# Run this only in one process. Set false for API replicas and use one dedicated worker.
RUN_VOUCHER_CLEANUP=true

# Payment gateway secrets: configure only if the relevant integration is enabled.
AZAMPAY_APP_NAME="POAFI_MASTER"
AZAMPAY_CLIENT_ID="your_azampay_client_id_here"
AZAMPAY_API_KEY="your_azampay_api_key_here"
AZAMPAY_CLIENT_SECRET="your_azampay_client_secret_here"
AZAMPAY_IS_LIVE=false

# Percentage commission the platform owner keeps (0-100).
PLATFORM_COMMISSION_PERCENT=10
