NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/poafi_db?schema=public"
# Preserve existing values if database credentials are already encrypted / JWTs are in use.
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
CREDENTIAL_ENCRYPTION_KEY="REPLACE_WITH_EXACTLY_32_CHARACTERS"
DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Optional; metrics endpoint returns 404 unless this is configured and supplied as Bearer token.
METRICS_TOKEN=""
RUN_VOUCHER_CLEANUP_IN_API=true
VOUCHER_CLEANUP_INTERVAL_MS=60000

# AzamPay sandbox credentials only; do not commit real credentials.
AZAMPAY_APP_NAME="POAFI_MASTER"
AZAMPAY_CLIENT_ID=""
AZAMPAY_API_KEY=""
AZAMPAY_CLIENT_SECRET=""
AZAMPAY_IS_LIVE=false
PLATFORM_COMMISSION_PERCENT=10
