# =========================================================================
# PoaFi Backend - environment template
# Copy to .env and fill in. NEVER commit the real .env file.
# See ENV-CREDENTIALS-GUIDE.md for how to obtain each value.
# =========================================================================

# ---- Core (REQUIRED) ----------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/poafi_db?schema=public"
# 128 hex chars: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME"
# EXACTLY 32 chars: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY="CHANGE_ME_exactly_32_characters!!"

# Simulation must stay false in production.
ALLOW_PAYMENT_SIMULATION=false

# ---- Public URLs (REQUIRED for production / real routers) ----------------
# Dashboard + captive portal URL (frontend)
PUBLIC_APP_URL="https://app.yourdomain.co.tz"
# API URL reachable by routers over the internet (HTTPS)
PUBLIC_API_URL="https://api.yourdomain.co.tz"
# Comma-separated allowed browser origins
CORS_ORIGIN="https://app.yourdomain.co.tz"

# ---- PoaFi Pay master gateway (AzamPay) --------------------------------
AZAMPAY_APP_NAME="POAFI_MASTER"
AZAMPAY_CLIENT_ID=""
AZAMPAY_CLIENT_SECRET=""
AZAMPAY_API_KEY=""
AZAMPAY_WEBHOOK_SECRET=""
# false = sandbox, true = real money
AZAMPAY_IS_LIVE=false

# Platform commission % kept from PoaFi Pay collections
PLATFORM_COMMISSION_PERCENT=10

# ---- SMS (Beem Africa) - payout OTP & voucher SMS ------------------------
BEEM_API_KEY=""
BEEM_SECRET_KEY=""
BEEM_SENDER_ID="POAFI"

# ---- WireGuard cloud tunnel (OPTIONAL - VPS only; leave blank on Shared Hosting) ----
# On Shared Hosting (cPanel / Passenger), leave WG_SERVER_ENDPOINT blank.
# Routers automatically use outbound HTTPS Cloud Sync (/api/enroll/sync/:routerId) over port 443.
WG_SERVER_ENDPOINT=""
WG_SERVER_PUBLIC_KEY=""
WG_SERVER_IP="10.8.0.1"

# ---- Shared Hosting (cPanel / Passenger / LiteSpeed) ---------------------
# Set TRUST_PROXY=1 behind cPanel/Passenger/Apache/Cloudflare so rate limiting sees real visitor IPs
TRUST_PROXY=1
# Set BACKGROUND_JOBS=false on shared hosting where idle processes sleep, and use cPanel Cron Jobs
BACKGROUND_JOBS=false
# Secret for cPanel Cron Job: curl -fsS -H "X-Cron-Secret: YOUR_SECRET" https://yourdomain.co.tz/api/internal/cron/run
# Min 32 chars: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="CHANGE_ME_min_32_characters_cron_secret_token"
# Keep DB pool small on shared hosting / free cloud PostgreSQL (default: 5)
DB_POOL_MAX=5
# Set to true for remote cloud Postgres (Neon, Supabase, Aiven); false for local cPanel Postgres
DB_SSL=false
# Cookie SameSite policy ('lax' for same-domain / subdomains, 'none' for cross-domain HTTPS)
COOKIE_SAME_SITE=lax

# ---- FreeRADIUS bridge (optional) ---------------------------------------
RADIUS_ENABLED=false
RADIUS_SERVER_HOST=""
# min 32 chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RADIUS_REST_SHARED_SECRET=""
