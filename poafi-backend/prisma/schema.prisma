generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  users         User[]
  routers       Router[]
  packages      Package[]
  vouchers      Voucher[]
  payments      Payment[]
  paymentConfig PaymentConfig?
  radiusNas     RadiusNas[]
  deviceSetupRequests DeviceSetupRequest[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  email        String   @unique
  passwordHash String
  role         String   @default("TENANT_OWNER")
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedSetupRequests DeviceSetupRequest[] @relation("AssignedSetupRequests")
}

model Router {
  id                  String   @id @default(uuid())
  tenantId            String
  name                String
  vendor              String   @default("MIKROTIK")
  host                String
  apiPort             Int      @default(8728)
  username            String
  encryptedPassword   String
  status              String   @default("UNKNOWN")
  deviceModelId       String?
  siteName            String?
  installationAddress String?
  connectionMode      String   @default("DIRECT")
  setupStatus         String   @default("PENDING")
  installationNotes   String?

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packages     Package[]
  deviceModel  NetworkDeviceModel? @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)
  radiusNas    RadiusNas[]
  deviceSetupRequests DeviceSetupRequest[]

  @@index([tenantId])
  @@index([deviceModelId])
}

model NetworkDeviceModel {
  id                 String   @id @default(uuid())
  brand              String
  model              String
  category           String
  subcategory        String?
  environment        String   @default("INDOOR")
  coverageMeters     Int?
  coverageNote       String?
  frequencyBands     String[] @default([])
  wifiStandard       String?
  maxClients         Int?
  maxSpeedMbps       Int?
  antenna            String?
  poe                String?
  ipRating           String?
  managementPlatform String?
  hotspotSupport     Boolean  @default(false)
  notes              String?
  sourceUrl          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  routers            Router[]
  deviceSetupRequests DeviceSetupRequest[]

  @@unique([brand, model])
  @@index([category])
  @@index([brand])
  @@index([coverageMeters])
}

model DeviceSetupRequest {
  id              String   @id @default(uuid())
  tenantId        String
  requestType     String   @default("SELF") // SELF or ASSISTED
  status          String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  deviceName      String?
  deviceVendor    String?
  deviceModelId   String?
  macAddress      String?
  serialNumber    String?
  notes           String?
  adminNotes      String?
  assignedToId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceModel     NetworkDeviceModel? @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)
  assignedTo      User?               @relation("AssignedSetupRequests", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
}

model Package {
  id              String    @id @default(uuid())
  tenantId        String
  routerId        String?
  name            String
  priceTzs        Int
  durationMinutes Int
  downloadKbps    Int       @default(3000)
  uploadKbps      Int       @default(1000)
  dataLimitMb     Int?
  type            String    @default("TIME")
  validityDays    Int?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  router    Router?   @relation(fields: [routerId], references: [id])
  vouchers  Voucher[]
  payments  Payment[]

  @@index([tenantId])
}

model Voucher {
  id              String    @id @default(uuid())
  batchId         String
  tenantId        String
  packageId       String
  codeHash        String    @unique
  encryptedCode   String
  status          String    @default("UNUSED")
  activatedAt     DateTime?
  expiresAt       DateTime?
  usedByIp        String?
  prefix          String?
  isImported      Boolean   @default(false)
  issuedAt        DateTime?
  createdAt       DateTime  @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package        Package         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payment        Payment?
  radiusSessions RadiusSession[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([batchId])
}

model Payment {
  id              String    @id @default(uuid())
  tenantId        String
  packageId       String
  voucherId       String?   @unique
  amount          Int
  currency        String    @default("TZS")
  provider        String
  phoneNumber     String
  reference       String    @unique
  externalId      String?
  status          String    @default("PENDING")
  accessTokenHash String?   @unique
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package  Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  voucher  Voucher? @relation(fields: [voucherId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([reference])
  @@index([phoneNumber])
}

model RadiusNas {
  id              String   @id @default(uuid())
  tenantId        String
  routerId        String?
  vendor          String   @default("GENERIC")
  model           String?
  name            String
  nasname         String   @unique @db.VarChar(128)
  shortname       String   @db.VarChar(32)
  type            String   @default("other") @db.VarChar(30)
  encryptedSecret String   @db.Text
  description     String?  @db.VarChar(200)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  router   Router?         @relation(fields: [routerId], references: [id], onDelete: SetNull)
  sessions RadiusSession[]

  @@index([tenantId])
  @@index([routerId])
  @@map("radius_nas")
}

model RadiusSession {
  id                 String    @id @default(uuid())
  nasId              String
  voucherId          String?
  acctSessionId      String
  username           String
  status             String    @default("START")
  framedIpAddress    String?
  callingStationId   String?
  calledStationId    String?
  inputOctets        BigInt    @default(0)
  outputOctets       BigInt    @default(0)
  sessionTimeSeconds Int       @default(0)
  startedAt          DateTime?
  lastUpdatedAt      DateTime  @updatedAt
  stoppedAt          DateTime?

  nas     RadiusNas @relation(fields: [nasId], references: [id], onDelete: Cascade)
  voucher Voucher?  @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@unique([nasId, acctSessionId])
  @@index([voucherId])
  @@index([username])
  @@index([status, lastUpdatedAt])
  @@map("radius_sessions")
}

model PaymentConfig {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  provider          String   @default("AZAMPAY")
  appName           String?
  clientId          String?
  encryptedApiKey   String?
  encryptedSecret   String?
  webhookSecret     String?
  isLive            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model OperatorApplication {
  id           String    @id @default(uuid())
  businessName String
  contactName  String
  email        String    @unique
  phone        String
  city         String
  message      String?
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewNote   String?
}