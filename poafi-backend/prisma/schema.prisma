generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  users         User[]
  routers       Router[]
  packages      Package[]
  vouchers      Voucher[]
  payments      Payment[]
  paymentConfig PaymentConfig?
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  email        String   @unique
  passwordHash String
  role         String   @default("TENANT_OWNER")
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Router {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  vendor            String   @default("MIKROTIK")
  host              String
  apiPort           Int      @default(8728)
  username          String
  encryptedPassword String
  status            String   @default("UNKNOWN")
  
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packages          Package[]

  @@index([tenantId])
}

model Package {
  id              String    @id @default(uuid())
  tenantId        String
  routerId        String?
  name            String
  priceTzs        Int
  durationMinutes Int
  downloadKbps    Int       @default(3000)
  uploadKbps      Int       @default(1000)

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  router          Router?   @relation(fields: [routerId], references: [id])
  vouchers        Voucher[]
  payments        Payment[]

  @@index([tenantId])
}

model Voucher {
  id            String    @id @default(uuid())
  batchId       String
  tenantId      String
  packageId     String
  codeHash      String    @unique
  encryptedCode String   
  status        String    @default("UNUSED")
  activatedAt   DateTime?
  expiresAt     DateTime?
  usedByIp      String?
  createdAt     DateTime  @default(now())
  
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package       Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payment       Payment?

  @@index([tenantId])
  @@index([tenantId, status])
}

model Payment {
  id            String    @id @default(uuid())
  tenantId      String
  packageId     String
  voucherId     String?   @unique
  amount        Int       // In TZS
  currency      String    @default("TZS")
  provider      String    // MPESA, TIGOPESA, AIRTEL, HALOPESA, CARD, AZAMPAY
  phoneNumber   String
  reference     String    @unique // Internal reconciliation reference e.g. POAF-xxxx
  externalId    String?   // External transaction ID from AzamPay / Telco
  status        String    @default("PENDING") // PENDING, SUCCESS, FAILED, CANCELLED
  metadata      String?   // Stored JSON string
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package       Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  voucher       Voucher?  @relation(fields: [voucherId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([reference])
  @@index([phoneNumber])
}

model PaymentConfig {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  provider          String   @default("AZAMPAY")
  appName           String?
  clientId          String?
  encryptedApiKey   String?
  encryptedSecret   String?
  webhookSecret     String?
  isLive            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model OperatorApplication {
  id           String    @id @default(uuid())
  businessName String
  contactName  String
  email        String    @unique
  phone        String
  city         String
  message      String?
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewNote   String?
}
