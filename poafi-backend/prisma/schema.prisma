generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  users         User[]
  routers       Router[]
  packages      Package[]
  deviceSetupRequests DeviceSetupRequest[]
  vouchers      Voucher[]
  payments      Payment[]
  paymentConfig PaymentConfig?
  radiusNas     RadiusNas[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  email        String   @unique
  passwordHash String
  role         String   @default("TENANT_OWNER")
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Router {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  vendor            String   @default("MIKROTIK")
  host              String
  apiPort           Int      @default(8728)
  username          String
  encryptedPassword String
  status            String   @default("UNKNOWN")
  
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packages          Package[]
  radiusNas         RadiusNas[]
  setupRequests     DeviceSetupRequest[]
  provisioningEnrollments RouterProvisioningEnrollment[]
  deviceModel       NetworkDeviceModel? @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)
  deviceModelId     String?
  siteName          String?
  installationAddress String?
  connectionMode    String   @default("DIRECT")
  setupStatus       String   @default("PENDING")
  installationNotes String?

  @@index([tenantId])
  @@index([deviceModelId])
}


model NetworkDeviceModel {
  id                 String   @id @default(uuid())
  brand              String
  model              String
  category           String
  subcategory        String?
  environment        String   @default("INDOOR")
  coverageMeters     Int?
  coverageNote       String?
  frequencyBands     String[] @default([])
  wifiStandard       String?
  maxClients         Int?
  maxSpeedMbps       Int?
  antenna            String?
  poe                String?
  ipRating           String?
  managementPlatform String?
  hotspotSupport     Boolean  @default(false)
  notes              String?
  sourceUrl          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  routers            Router[]
  deviceSetupRequests DeviceSetupRequest[]

  @@unique([brand, model])
  @@index([category])
  @@index([brand])
  @@index([coverageMeters])
}

model Package {
  id              String    @id @default(uuid())
  tenantId        String
  routerId        String?
  name            String
  priceTzs        Int
  durationMinutes Int
  downloadKbps    Int       @default(3000)
  uploadKbps      Int       @default(1000)
  dataLimitMb     Int?
  type            String    @default("TIME")
  validityDays    Int?

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  router          Router?   @relation(fields: [routerId], references: [id])
  vouchers        Voucher[]
  payments        Payment[]

  @@index([tenantId])
}

model Voucher {
  id            String    @id @default(uuid())
  batchId       String
  tenantId      String
  packageId     String
  codeHash      String    @unique
  encryptedCode String   
  status        String    @default("UNUSED")
  activatedAt   DateTime?
  expiresAt     DateTime?
  usedByIp      String?
  prefix        String?
  isImported    Boolean   @default(false)
  issuedAt      DateTime?
  radiusSessions RadiusSession[]
  createdAt     DateTime  @default(now())
  
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package       Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payment       Payment?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([batchId])
}

model Payment {
  id              String    @id @default(uuid())
  tenantId        String
  packageId       String
  voucherId       String?   @unique
  amount          Int       // In TZS
  currency        String    @default("TZS")
  provider        String    // MPESA, TIGOPESA, AIRTEL, HALOPESA, CARD, AZAMPAY
  phoneNumber     String
  reference       String    @unique // Internal reconciliation reference e.g. POAF-xxxx
  externalId      String?   // External transaction ID from AzamPay / Telco
  status          String    @default("PENDING") // PENDING, SUCCESS, FAILED, CANCELLED
  accessTokenHash String?   @unique // Hash of short-lived portal polling token; never store raw token
  metadata        String?   // Stored JSON string
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package       Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  voucher       Voucher?  @relation(fields: [voucherId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([reference])
  @@index([phoneNumber])
}

model RadiusNas {
  id              String   @id @default(uuid())
  tenantId        String
  routerId        String?
  vendor          String   @default("GENERIC") @db.VarChar(80)
  model           String?
  name            String
  nasname         String   @unique @db.VarChar(128)
  shortname       String   @db.VarChar(32)
  type            String   @default("other") @db.VarChar(30)
  encryptedSecret String   @db.Text
  description     String?  @db.VarChar(200)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  router   Router?         @relation(fields: [routerId], references: [id], onDelete: SetNull)
  sessions RadiusSession[]

  @@index([tenantId])
  @@index([routerId])
  @@map("radius_nas")
}

model RadiusSession {
  id                 String    @id @default(uuid())
  nasId              String
  voucherId          String?
  acctSessionId      String
  username           String
  status             String    @default("START")
  framedIpAddress    String?
  callingStationId   String?
  calledStationId    String?
  inputOctets        BigInt    @default(0)
  outputOctets       BigInt    @default(0)
  sessionTimeSeconds Int       @default(0)
  startedAt          DateTime?
  lastUpdatedAt      DateTime  @updatedAt
  stoppedAt          DateTime?

  nas     RadiusNas @relation(fields: [nasId], references: [id], onDelete: Cascade)
  voucher Voucher?  @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@unique([nasId, acctSessionId])
  @@index([voucherId])
  @@index([username])
  @@index([status, lastUpdatedAt])
  @@map("radius_sessions")
}

model PaymentConfig {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  provider          String   @default("AZAMPAY")
  appName           String?
  clientId          String?
  encryptedApiKey   String?
  encryptedSecret   String?
  webhookSecret     String?
  isLive            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model OperatorApplication {
  id           String    @id @default(uuid())
  businessName String
  contactName  String
  email        String    @unique
  phone        String
  city         String
  message      String?
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewNote   String?
}


model DeviceSetupRequest {
  id                   String   @id @default(uuid())
  tenantId             String
  routerId             String?
  deviceModelId        String?
  setupMode            String   // SELF_SERVICE or ADMIN_ASSISTANCE
  supportMethod        String?  // REMOTE or PHYSICAL_HANDOVER, only for admin assistance
  status               String   @default("SUBMITTED")
  vendor               String
  modelName            String?
  deviceCategory       String
  serialNumber         String?
  siteName             String?
  siteAddress          String?
  requestedCapabilities String[] @default([])
  operatorNotes        String?
  adminNotes           String?
  reviewedAt           DateTime?
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  router      Router?            @relation(fields: [routerId], references: [id], onDelete: SetNull)
  deviceModel NetworkDeviceModel? @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([setupMode, status])
  @@index([routerId])
  @@index([deviceModelId])
}


model RouterProvisioningEnrollment {
  id              String   @id @default(uuid())
  routerId        String
  tokenHash       String   @unique
  assignedAddress String   @unique
  routerPublicKey String?
  status          String   @default("SCRIPT_ISSUED")
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  router Router @relation(fields: [routerId], references: [id], onDelete: Cascade)

  @@index([routerId, status])
  @@index([expiresAt])
}
