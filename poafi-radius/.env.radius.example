# Local Windows/XAMPP-style development: backend running on host port 4000.
# For production, use the private DNS/service name of your PoaFi backend.
POAFI_API_URL=http://host.docker.internal:4000

# Generate once, then set the exact same value as RADIUS_REST_SHARED_SECRET
# in poafi-backend/.env. Keep it private.
RADIUS_REST_SHARED_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_BACKEND
