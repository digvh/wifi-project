server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }
    listen {
        type = acct
        ipaddr = *
        port = 1813
    }

    authorize {
        filter_username
        preprocess
        rest
        pap
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type rest {
            rest
        }
    }

    accounting {
        rest
    }
}
